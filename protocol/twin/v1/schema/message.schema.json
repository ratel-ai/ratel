{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/twin/v1/message.schema.json",
  "title": "Message",
  "description": "Any twin/v1 frame. It dispatches on type to the schema of that message. A receiver drops, and does not fail on, a frame whose type it does not know: new types are additive within v1.",
  "$ref": "envelope.schema.json",
  "properties": {
    "type": {
      "enum": [
        "drain",
        "events.ack",
        "manifest.update",
        "register",
        "registered",
        "run.ack",
        "run.cancel",
        "run.end",
        "run.event",
        "run.lease",
        "run.reject",
        "run.start",
        "tool.confirm.decision",
        "tool.confirm.request",
        "tool.fake.request",
        "tool.fake.result"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "drain"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/drain.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "events.ack"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/events.ack.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "manifest.update"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/manifest.update.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "register"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/register.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "registered"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/registered.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.ack"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/run.ack.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.cancel"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/run.cancel.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.end"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/run.end.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.event"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/run.event.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.lease"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/run.lease.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.reject"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/run.reject.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.start"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/run.start.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.confirm.decision"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/tool.confirm.decision.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.confirm.request"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/tool.confirm.request.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.fake.request"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/tool.fake.request.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.fake.result"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "messages/tool.fake.result.schema.json"
      }
    }
  ]
}
