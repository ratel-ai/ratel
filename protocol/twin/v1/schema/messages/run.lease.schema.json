{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/twin/v1/messages/run.lease.schema.json",
  "title": "run.lease",
  "description": "From the worker. The run is still alive. Sent every leaseIntervalMs.",
  "$ref": "../envelope.schema.json",
  "required": [
    "payload",
    "runId"
  ],
  "properties": {
    "type": {
      "const": "run.lease"
    },
    "payload": {
      "type": "object",
      "properties": {
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
