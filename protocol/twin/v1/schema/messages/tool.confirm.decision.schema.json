{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/twin/v1/messages/tool.confirm.decision.schema.json",
  "title": "tool.confirm.decision",
  "description": "From the controller. The reviewer decision for a tool.confirm.request. No decision within confirmTimeoutMs means reject.",
  "$ref": "../envelope.schema.json",
  "required": [
    "payload",
    "runId"
  ],
  "properties": {
    "type": {
      "const": "tool.confirm.decision"
    },
    "payload": {
      "type": "object",
      "required": [
        "callId",
        "decision"
      ],
      "properties": {
        "callId": {
          "$ref": "../envelope.schema.json#/$defs/callId"
        },
        "decision": {
          "enum": [
            "approve",
            "edit",
            "fake",
            "reject"
          ]
        },
        "args": {
          "description": "The edited arguments (edit)."
        },
        "result": {
          "description": "The fake value (fake)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "edit"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "fake"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ]
          }
        }
      ]
    }
  }
}
