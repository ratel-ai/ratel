{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/twin/v1/messages/events.ack.schema.json",
  "title": "events.ack",
  "description": "From the controller. The controller stored every event of the run up to seq.",
  "$ref": "../envelope.schema.json",
  "required": [
    "payload",
    "runId"
  ],
  "properties": {
    "type": {
      "const": "events.ack"
    },
    "payload": {
      "type": "object",
      "required": [
        "seq"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
