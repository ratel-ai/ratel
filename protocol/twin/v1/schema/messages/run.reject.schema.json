{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/twin/v1/messages/run.reject.schema.json",
  "title": "run.reject",
  "description": "From the worker. The worker refused run.start. Sent within ackTimeoutMs.",
  "$ref": "../envelope.schema.json",
  "required": [
    "payload",
    "runId"
  ],
  "properties": {
    "type": {
      "const": "run.reject"
    },
    "payload": {
      "type": "object",
      "required": [
        "reason",
        "message"
      ],
      "properties": {
        "reason": {
          "enum": [
            "busy",
            "unknown_twin",
            "invalid_params"
          ]
        },
        "message": {
          "type": "string"
        },
        "errors": {
          "description": "For invalid_params: one entry per bad param.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "param",
              "message"
            ],
            "properties": {
              "param": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
