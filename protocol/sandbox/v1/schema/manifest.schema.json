{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/sandbox/v1/manifest.schema.json",
  "title": "Manifest",
  "description": "What a worker can run: its sandboxes, their params, input and context, the model providers it can call (key names only) and its SDK and build versions. It is plain data. A controller never sends code.",
  "type": "object",
  "required": ["sdk", "sandboxes", "providers"],
  "properties": {
    "sdk": {
      "type": "object",
      "required": ["language", "name", "version"],
      "properties": {
        "language": { "enum": ["typescript", "python"] },
        "name": { "description": "The SDK package, e.g. @ratel-ai/sandbox or ratel-sandbox.", "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "description": "The code the worker loaded.",
      "type": "object",
      "properties": {
        "id": { "description": "The git commit SHA, if known.", "type": "string", "minLength": 1 },
        "dirty": { "description": "True when the working tree has uncommitted changes.", "type": "boolean" },
        "revision": {
          "description": "Optional. A revision of the loaded sandbox code: lowercase hex SHA-256 of the sandbox files' content. It changes with every edit of a sandbox file, also without git or in a dirty checkout.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "providers": {
      "description": "The model providers the worker can call. Key names only, never key values.",
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    },
    "sandboxes": {
      "type": "array",
      "items": { "$ref": "#/$defs/sandbox" }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["provider", "keys"],
      "properties": {
        "provider": { "description": "The prefix of a model value, e.g. anthropic in anthropic/claude-sonnet-5-5.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "keys": {
          "description": "The names of the environment variables that hold the credentials.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "required": ["id", "input", "params"],
      "properties": {
        "id": { "$ref": "envelope.schema.json#/$defs/sandboxId" },
        "file": { "description": "The sandbox file, relative to the project root.", "type": "string" },
        "modelResolver": {
          "description": "builtin: the runner maps provider/model values. custom: the sandbox passes its own resolve.",
          "enum": ["builtin", "custom"]
        },
        "modelKind": {
          "description": "Optional. language-model: run() gets an AI SDK LanguageModel, so a model value is callable only through a listed provider (gateway, or the model's own provider). Absent: run() gets the bare model ID.",
          "enum": ["language-model"]
        },
        "input": { "$ref": "#/$defs/input" },
        "output": { "$ref": "#/$defs/output" },
        "state": {
          "description": "Optional. run (the default when absent): one instance per run. session: one instance per session, kept across its turns.",
          "enum": ["run", "session"]
        },
        "image": { "$ref": "#/$defs/image" },
        "params": {
          "description": "The params Ratel can change per run, in declaration order. Names are unique.",
          "type": "array",
          "items": { "$ref": "#/$defs/param" }
        },
        "context": {
          "description": "Fixed inputs that are not under test (tenant, org).",
          "type": "array",
          "items": { "$ref": "#/$defs/contextField" }
        }
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "structured" },
            "schema": { "description": "A JSON Schema of the one input object.", "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "chat" } }
        }
      ]
    },
    "output": {
      "description": "Optional. What run() returns: one JSON value described by a JSON Schema, or free text.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "structured" },
            "schema": { "description": "A JSON Schema of the output.", "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "text" } }
        }
      ]
    },
    "image": {
      "description": "Optional. What a hosted instance needs besides the code, in a provider-neutral shape. A provider maps it to its own image and sidecars.",
      "type": "object",
      "required": ["base"],
      "additionalProperties": false,
      "properties": {
        "base": { "description": "The base container image, e.g. node:22-slim.", "type": "string", "minLength": 1 },
        "install": {
          "description": "Shell commands run in order at build time.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "copy": {
          "description": "Paths copied into the image, relative to the project root. They never leave it.",
          "type": "array",
          "items": { "$ref": "#/$defs/projectPath" }
        },
        "sidecars": {
          "description": "Services next to the sandbox. One of each kind at most.",
          "type": "array",
          "items": { "$ref": "#/$defs/sidecar" }
        },
        "env": {
          "description": "The names of the env vars the instance gets from the project secrets. Names only, never values.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
        }
      }
    },
    "sidecar": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "postgres" },
            "version": { "$ref": "#/$defs/sidecarVersion" },
            "seed": { "description": "A SQL file run once when the database starts.", "$ref": "#/$defs/projectPath" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "redis" },
            "version": { "$ref": "#/$defs/sidecarVersion" }
          }
        }
      ]
    },
    "sidecarVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" },
    "projectPath": {
      "description": "A relative path inside the project root: not absolute, no .. segment that leaves it.",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(/|[A-Za-z]:|\\\\)|(^|/)\\.\\.(/|$)" }
    },
    "contextField": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/paramName" },
        "description": { "type": "string" },
        "default": true
      }
    },
    "paramName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
    "modelId": {
      "description": "provider/model, e.g. anthropic/claude-sonnet-5-5.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/.+$"
    },
    "param": {
      "type": "object",
      "required": ["name", "kind", "default"],
      "properties": {
        "name": { "$ref": "#/$defs/paramName" },
        "kind": { "enum": ["model", "prompt", "tools", "scalar"] },
        "description": { "type": "string" },
        "default": true
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "model" } } },
          "then": {
            "properties": {
              "default": { "$ref": "#/$defs/modelId" },
              "options": { "type": "array", "items": { "$ref": "#/$defs/modelId" } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "prompt" } } },
          "then": {
            "properties": {
              "default": { "type": "string" },
              "vars": { "description": "Template variable names the code renders.", "type": "array", "items": { "type": "string" } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "tools" } } },
          "then": {
            "properties": {
              "default": { "type": "array", "items": { "$ref": "#/$defs/tool" } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "scalar" } } },
          "then": { "required": ["type"], "$ref": "#/$defs/scalar" }
        }
      ]
    },
    "scalar": {
      "properties": {
        "type": { "enum": ["int", "number", "bool", "enum", "string"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "int" } } },
          "then": {
            "properties": {
              "default": { "type": "integer" },
              "min": { "type": "integer" },
              "max": { "type": "integer" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "properties": {
              "default": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "bool" } } },
          "then": { "properties": { "default": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": {
            "required": ["values"],
            "properties": {
              "default": { "type": "string" },
              "values": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": {
            "properties": {
              "default": { "type": "string" },
              "maxLength": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "hint": {
          "description": "readOnly defaults to real, sideEffect to fake, none to confirm.",
          "enum": ["readOnly", "sideEffect", "none"]
        },
        "allowReal": { "description": "A sideEffect tool runs real only when this is true.", "type": "boolean" },
        "opaque": { "description": "A meta-tool or sub-agent: the mode applies to the whole outer call.", "type": "boolean" }
      }
    }
  }
}
