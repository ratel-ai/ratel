# Copy to .env. Docker Compose reads it, and git and the image build ignore it.
# Everything here is optional on your own machine. On a server, set the first four
# before the first start. Generate each secret with: openssl rand -hex 32

# The organization's name, read at every start.
RATEL_ORG_NAME=

# Where SDK snippets in the console point: this deployment's API, with its /api/v1 prefix.
BASE_URL=http://localhost:3000/api/v1

# Read only when the database is first created. Changing it later means deleting the data:
# docker compose down --volumes. Letters and digits only: it goes into a connection URL.
POSTGRES_PASSWORD=ratel

# Keeps hashed values in the database from being guessed. Empty uses the public development
# salt. Changing it later splits what was hashed before from what comes after.
TRACE_SIGNALS_HASH_SALT=

# Host ports, both bound to 127.0.0.1. If you change RATEL_PORT, change BASE_URL too.
RATEL_PORT=3000
RATEL_DB_PORT=5432

# Optional model keys. Without them nothing is sent to a model provider, and features
# fall back to names built from your own data.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
