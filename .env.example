# Copy to .env. Docker Compose reads it, and git and the image build ignore it.
# Everything here is optional on your own machine. On a server, set RATEL_ORG_NAME, BASE_URL and
# the two secrets before the first start. Generate each secret with: openssl rand -hex 32

# The release to run: a tag of https://hub.docker.com/r/ratelai/ratel. Set it to upgrade, then
# run: docker compose up -d --wait
# x-release-please-start-version
RATEL_VERSION=0.5.0
# x-release-please-end

# The organization's name, read at every start.
RATEL_ORG_NAME=

# Where SDK snippets in the console point: this deployment's origin.
# The console adds /api/v1 when it builds API and ingest URLs.
BASE_URL=http://localhost:3000

# Read only when the database is first created. Changing it later means deleting the data:
# docker compose down --volumes. Letters and digits only: it goes into a connection URL.
POSTGRES_PASSWORD=ratel

# Keeps hashed values in the database from being guessed. Empty uses the public development
# salt. Changing it later splits what was hashed before from what comes after.
TRACE_SIGNALS_HASH_SALT=

# Host ports, both bound to 127.0.0.1. If you change RATEL_PORT, change BASE_URL too.
RATEL_PORT=3000
RATEL_DB_PORT=5432

# Experimental features, all off by default: testing a fix before it ships, session replay
# with the session chat, the Traces Sessions tab, the Health score and the early readings.
# 1 turns them all on.
# RATEL_EXPERIMENTAL_FEATURES=1

# Optional model keys. Without them nothing is sent to a model provider, and features
# fall back to names built from your own data.
# ANTHROPIC_API_KEY=
# bedrock = Claude through Amazon Bedrock EU inference profiles with the AWS credential chain,
# in place of ANTHROPIC_API_KEY. See web/.env.example.
# ANTHROPIC_BACKEND=bedrock
# OPENAI_API_KEY=
