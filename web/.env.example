# Copy to .env.local. Every setting below can also come from a JSON config file named by
# CONFIG_PATH (its keys: web/src/config.ts; a sample: web/config.example.json), or from both:
# env > file > default. An invalid value stops the app at boot.
# CONFIG_PATH=./config.json

# Postgres database URL and settings.
# Default is a local Docker Compose setup.
DATABASE_URL=postgres://ratel:ratel@localhost:5432/ratel
DATABASE_MIGRATE_ON_BOOT=1
# RQL queries (FF_CUSTOM_MONITORING) run on a small pool of their own, so they never take a connection that
# ingest or a page needs. Unset, that pool connects to DATABASE_URL. Set it to a read replica, or
# to a user of its own. RQL runs as the role ratel_rql (migration 0057_rql_views makes it), so
# the user of this URL must be a member: the migration grants it to the user that runs it, else
# run GRANT ratel_rql TO <user>. A migration user that cannot CREATE ROLE leaves RQL off.
# RQL_DATABASE_URL=

# Where SDK snippets in the console point: this deployment's origin.
# The console adds /api/v1 when it builds API and ingest URLs.
BASE_URL=http://localhost:3000

# Seals the secrets the app stores and reads back (the Slack webhook URLs of Alerts). 32 characters
# or more: openssl rand -hex 32. Empty, no Slack destination can be added. Another value later
# cannot open what this one sealed: add the destinations again.
RATEL_SECRET_KEY=

# Where the DB-IP Lite file is, which resolves IP addresses to a country and a region for the map
# widget (docs/geography.md): GEO_DATABASE_PATH=… pnpm --filter @ratel/platform geo:download
# Empty, addresses are not resolved and the location attributes still work.
GEO_DATABASE_PATH=

# Experimental features, all off by default: the eval gate (test a fix on the project's past
# runs before it ships), session replay with the session chat, the Traces Sessions tab, the
# Health score and the early readings, the redesigned trace views, raw OTLP capture (each
# accepted request body kept, gzipped, up to OTLP_RAW_DAILY_BYTES per project per day),
# adaptive labelling, the MCP server's interactive views (MCP Apps), tool-run insights, the
# simplified console, Scorers, custom Dashboards and Alerts. 1 turns them all on.
# RATEL_EXPERIMENTAL_FEATURES=1
# The eval gate's models: re-rank fixes simulate in process. Fixes that need a model replay,
# and judged criteria, call Anthropic with ANTHROPIC_API_KEY; without it they say no model is
# configured and nothing calls out. EVAL_GATE_MOCK_MODEL=1 uses deterministic stand-ins instead
# (ignored when APP_ENV is production).
# EVAL_GATE_MOCK_MODEL=1
# EVAL_GATE_REPLAY_BUDGET_USD=1
# EVAL_GATE_JUDGE_BUDGET_USD=0.1
# Advanced: each feature flag on its own (config file: flags.<key>). Each takes true, 1, false or 0;
# unset, the flag is not forced.
# FF_EVAL_GATE (evalGate) alone turns on the eval gate (run_eval and get_eval need it too).
# FF_RANKING_CATALOG_DRIFT (rankingCatalogDrift) alone turns on adaptive ranking's catalog drift: a tool is gone only when a
# published catalog dropped it and it went unused past a grace period; warnings are closable, and
# gone tools are pruned from the graph on rebuild.
# FF_MCP_APPS (mcpApps) alone turns on MCP Apps: the MCP server publishes interactive ui:// views (built by
# pnpm --filter @ratel/mcp-apps build) and points its tools at them, for hosts that show views.
# FF_AGENTS_PAGES (agentsPages) alone turns on the Agents and MCP servers pages and their MCP tools.
# FF_TOOL_RUN_INSIGHTS (toolRunInsights) alone turns on tool-run insights: tasks mined from a floor of three runs, a
# derived ask for a tool-only run, an OTel invoke_agent root span as an agent run with its own turn
# and task, and an Agent health reading from 10 turns marked low confidence.
# FF_FOCUSED_CONSOLE (focusedConsole) alone turns on the simplified console: Overview as a recap, Agent
# health as the score and its categories, and Self-corrections under Insights. 0 keeps today's console, RATEL_EXPERIMENTAL_FEATURES=1 included.
# FF_SANDBOXES (sandboxes) alone turns on Ratel sandboxes.
# FF_EVALS (evals) alone turns on evals. An eval run also needs Ratel sandboxes.
# SANDBOX_SECRETS_KEY seals sandbox secrets (openssl rand -base64 32). Keep it: without it the stored
# secrets do not open. SANDBOX_CONCURRENT_INSTANCES, SANDBOX_RUN_SECONDS, SANDBOX_RUNS_PER_DAY,
# SANDBOX_VERSIONS_PER_DAY and SANDBOX_BUNDLE_BYTES lower each project's limits. SANDBOX_BUNDLE_DIR is
# the folder of the pushed bundles: the web and the worker process must share it.
# FF_CUSTOM_MONITORING (customMonitoring) alone turns on Scorers, custom Dashboards, Alerts, Slack
# delivery and RQL, the read-only query language over trace data, with its MCP tools
# (describe_rql_schema, run_rql, query kind sql). Owner: rstagi; removed once on for all users.
# Everything else is on for every deployment, as upstream retired its flags: session replay (a
# session as a chat, and What-if), the v3 trace views, raw OTLP capture, Traces Sessions, adaptive
# labelling, the Health score and the quick and import first readings.
# What the worker stores besides this deployment's own ingest (docs/adr/0010-kafka-ingest.md). direct
# (default): nothing. kafka: the topics that a gateway writes; APP_ROLE=worker or all reads them, and
# needs NEXT_MANUAL_SIG_HANDLE=true to finish the message in hand before it stops. The routes and
# EXPERIMENTAL_INGEST_QUEUE do not depend on it. The topics must exist: they hold records of up to
# 4.1 MB, need at least two in-sync replicas in production, and order is kept per partition. Security is
# plaintext, tls or iam (Amazon MSK with the AWS credential chain; needs INGEST_KAFKA_REGION).
# INGEST_QUEUE=kafka
# INGEST_KAFKA_BROKERS=localhost:9092
# INGEST_KAFKA_SECURITY=plaintext
# INGEST_KAFKA_REGION=eu-central-1
# INGEST_KAFKA_TOPICS=ratel-ingest
# INGEST_KAFKA_GROUP_ID=ratel-ingest
# INGEST_KAFKA_DEAD_LETTER_TOPIC=ratel-ingest-dead-letters
# Raw OTLP request bodies: stored gzipped bytes one project may add per UTC day (default 1 GiB,
# 0 stores none), and their retention, which applies even with DATA_RETENTION_ENABLED unset
# (500 rows per tick).
# OTLP_RAW_DAILY_BYTES=1073741824
# OTLP_RAW_RETENTION_DAYS=30
# Experimental ingest queue (ADR-0009), off by default: /v1/traces, /v1/logs and /v1/events
# store the batch as sent and answer 202; a worker decodes and stores it, one project's backlog
# at a time per INGEST_PERSIST_PER_PROJECT. One process drains after its responses (up to
# INGEST_PERSIST_CONCURRENCY at once); with APP_ROLE=api or ingest, the worker (or a
# APP_ROLE=persist process) does. A batch is tried INGEST_BATCH_MAX_ATTEMPTS times, then failed.
# EXPERIMENTAL_INGEST_QUEUE=1
# INGEST_PERSIST_PER_PROJECT=1
# INGEST_PERSIST_CONCURRENCY=2
# INGEST_BATCH_MAX_ATTEMPTS=5

# Where Claude calls go. Unset, ANTHROPIC_API_KEY selects the Anthropic API.
# bedrock = every Claude call goes to Amazon Bedrock through eu.* inference
# profiles, signed by the AWS credential chain; ANTHROPIC_API_KEY is never used.
# AWS_BEARER_TOKEN_BEDROCK turns Claude off (it would replace the AWS credential
# chain); ANTHROPIC_BEDROCK_BASE_URL is ignored. Any other value turns Claude off.
# ANTHROPIC_BACKEND=bedrock

# Self-telemetry: the platform's own traces and logs, over OTLP/HTTP. Off unless both
# endpoints are set; with either one unset nothing is exported and nothing leaves the
# process. The _HEADERS variables carry the collector's credentials ("key=value,key=value").
# OTEL_TRACES_SAMPLER_ARG is the share of traces kept (0 to 1, default 1) and
# OTEL_SDK_DISABLED=true turns it all off. Buffered telemetry is flushed on SIGTERM; outside
# the worker that needs NEXT_MANUAL_SIG_HANDLE=true, or Next may exit before the flush ends.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_TRACES_SAMPLER_ARG=1
# The service name these traces and logs carry (the OpenTelemetry standard variable).
# OTEL_SERVICE_NAME=ratel-platform
# Server traces for APM: requests, Postgres queries and outbound calls, over OTLP/HTTP to a
# collector of your own (an OpenTelemetry Collector, a Datadog Agent…). Off unless the base
# endpoint is set; traces go to its /v1/traces. Independent of self-telemetry. Never sent:
# model-call and MCP tool spans, and URL query strings. SERVER_TRACES_RESOURCE_ATTRIBUTES
# ("key=value,…") overrides this exporter's resource, e.g. service.name and service.version.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# SERVER_TRACES_RESOURCE_ATTRIBUTES=service.name=ratel-platform
# Ratel as a customer of itself, riding on the self-telemetry above. With a project key and
# that deployment's /v1/traces (no default destination), the model calls Ratel pays for go to
# the key's project as gen_ai spans, with their prompt and answer; each background job that
# calls a model is one agent run there (invoke_agent <job kind>, with the job's ask). A second
# key sends each call to Ratel's own MCP tools, as an execute_tool span with its arguments and
# result, to a project of its own. Both hold customers' data. REPLACE_ME counts as unset.
# RATEL_SELF_TELEMETRY_ENDPOINT=
# RATEL_SELF_TELEMETRY_API_KEY=
# RATEL_SELF_TELEMETRY_PROJECT_ID=
# RATEL_SELF_TELEMETRY_MCP_API_KEY=
