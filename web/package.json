{
  "name": "@ratel/platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/link-ee.mjs --auto && pnpm mcp-apps:build && next dev",
    "build": "node ../scripts/link-ee.mjs --auto && pnpm mcp-apps:build && next build",
    "start": "next start",
    "typecheck": "node ../scripts/link-ee.mjs --auto && pnpm mcp-apps:build && tsc --noEmit",
    "lint": "biome check src scripts",
    "test": "pnpm mcp-apps:build && tsx --no-wasm-code-gc --test --test-force-exit ${TEST_SHARD:+--test-shard=$TEST_SHARD} \"src/lib/**/*.test.ts\" \"src/app/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "mcp-apps:build": "pnpm --filter @ratel/mcp-apps build",
    "mcp-apps:dev": "pnpm --filter @ratel/mcp-apps dev",
    "check:ds-tokens": "node scripts/check-ds-tokens.mjs",
    "migrate": "tsx scripts/migrate.mts",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-check.mjs",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.mts",
    "seed:quality": "tsx scripts/seed-site-copilot-quality.mts",
    "seed:task-loop": "tsx scripts/seed-task-loop.mts",
    "bedrock:smoke": "ANTHROPIC_BACKEND=bedrock tsx scripts/bedrock-smoke.mts",
    "otlp-raw:keys": "tsx scripts/otlp-raw-keys.ts",
    "otlp-raw:reprocess": "tsx scripts/reprocess-otlp-raw.ts",
    "backfill:costs": "tsx scripts/backfill-costs.ts",
    "backfill:entity-dimensions": "tsx scripts/backfill-entity-dimensions.ts",
    "traces:backfill-filters": "tsx scripts/backfill-trace-summary-filters.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.36.0",
    "@anthropic-ai/sdk": "^0.137.0",
    "@base-ui/react": "^1.6.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "~2.12.1",
    "@opentelemetry/core": "~2.12.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "~2.12.1",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-trace-base": "~2.12.0",
    "@opentelemetry/sdk-trace-node": "~2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@ratel-ai/sdk": "0.13.0-rc.9",
    "@ratel-ai/telemetry": "^0.5.0",
    "@ratel/brand": "workspace:*",
    "@ratel/design-system": "workspace:*",
    "@ratel/mcp-apps": "workspace:*",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "3.0.1",
    "d3-hierarchy": "3.1.3",
    "d3-sankey": "0.12.3",
    "d3-selection": "3.0.1",
    "d3-zoom": "3.0.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "protobufjs": "^8.6.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zfig": "0.9.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@opentelemetry/otlp-transformer": "^0.301.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-sankey": "0.12.5",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
