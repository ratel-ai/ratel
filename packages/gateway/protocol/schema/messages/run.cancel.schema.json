{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/sandbox/v1/messages/run.cancel.schema.json",
  "title": "run.cancel",
  "description": "From the controller. Abort the run: the worker aborts ctx.signal and ends the run with status canceled.",
  "$ref": "../envelope.schema.json",
  "required": [
    "payload",
    "runId"
  ],
  "properties": {
    "type": {
      "const": "run.cancel"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
