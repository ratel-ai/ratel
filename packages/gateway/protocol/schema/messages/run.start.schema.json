{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratel.sh/protocol/sandbox/v1/messages/run.start.schema.json",
  "title": "run.start",
  "description": "From the controller. Start one run. Idempotent by runId: a resent run.start does not run twice.",
  "$ref": "../envelope.schema.json",
  "required": [
    "payload",
    "runId"
  ],
  "properties": {
    "type": {
      "const": "run.start"
    },
    "payload": {
      "type": "object",
      "required": [
        "sandboxId",
        "input",
        "params",
        "configHash"
      ],
      "properties": {
        "sandboxId": {
          "$ref": "../envelope.schema.json#/$defs/sandboxId"
        },
        "sessionId": {
          "description": "The playground session. It becomes gen_ai.conversation.id.",
          "type": "string",
          "minLength": 1
        },
        "input": {
          "description": "One JSON object (structured) or { messages } (chat).",
          "type": "object"
        },
        "params": {
          "description": "Resolved param values by name. Plain data only.",
          "type": "object"
        },
        "toolModes": {
          "description": "Mode per tool name.",
          "type": "object",
          "additionalProperties": {
            "$ref": "../envelope.schema.json#/$defs/toolMode"
          }
        },
        "context": {
          "description": "Context values by name.",
          "type": "object"
        },
        "configHash": {
          "$ref": "../envelope.schema.json#/$defs/configHash"
        },
        "replay": {
          "type": "object",
          "properties": {
            "sourceTraceId": {
              "$ref": "../envelope.schema.json#/$defs/traceId"
            },
            "sourceSessionId": {
              "type": "string"
            },
            "arm": {
              "enum": [
                "baseline",
                "candidate"
              ]
            }
          }
        }
      }
    }
  }
}
