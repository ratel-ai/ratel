{
  "$comment": "Explicit import-specifier rules; apps/web/lib moves are derived from map.json. Longest `from` wins. `partitions` split named imports from hub modules per symbol (unlisted symbols go to `default` and are reported). `identifiers` are whole-word renames applied to every copied file.",
  "rules": [
    {
      "from": "@/components/ds/",
      "to": "@ratel/design-system/",
      "except": ["@/components/ds/entity", "@/components/ds/dot-loader"]
    },
    { "from": "@/lib/utils", "to": "@ratel/design-system/cn", "exact": true },
    { "from": "@/lib/cn", "to": "@ratel/design-system/cn", "exact": true },
    { "from": "@/lib/db/index", "to": "@/lib/platform/db/client", "exact": true },
    { "from": "@/lib/db", "to": "@/lib/platform/db/client", "exact": true },
    { "from": "@/lib/db/test-support", "to": "@/lib/platform/db/test-support", "exact": true },
    { "from": "@/lib/db/statement-timeout", "to": "@/lib/platform/db/statement-timeout", "exact": true },
    { "from": "@/lib/auth-user", "to": "@/lib/platform/session", "exact": true },
    { "from": "@/lib/entitlements", "to": "@/lib/platform/entitlements", "exact": true },
    { "from": "@/lib/analytics/track-server", "to": "@/lib/platform/telemetry", "exact": true },
    { "from": "@/lib/analytics/product-events", "to": "@/lib/platform/telemetry", "exact": true },
    { "from": "@/lib/observability/report-exception", "to": "@/lib/platform/telemetry", "exact": true },
    { "from": "@/lib/observability/resilient-read", "to": "@/lib/platform/resilient-read", "exact": true },
    { "from": "@/lib/environment", "to": "@/lib/platform/environment", "exact": true },
    { "from": "@/lib/scope/cookie", "to": "@/lib/console/scope/cookie", "exact": true },
    { "from": "@/lib/cron/drain", "to": "@/lib/jobs/drain", "exact": true },
    { "from": "@/lib/stripe/subscription", "to": "@/lib/platform/entitlements", "exact": true },
    { "from": "@/lib/stripe/plans", "to": "@/lib/platform/entitlements", "exact": true }
  ],
  "partitions": {
    "@/lib/db/schema": {
      "default": "@/lib/platform/db/tables",
      "symbols": {
        "organizations": "@/lib/platform/identity/schema",
        "users": "@/lib/platform/identity/schema",
        "memberships": "@/lib/platform/identity/schema",
        "Organization": "@/lib/platform/identity/schema",
