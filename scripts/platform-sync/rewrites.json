        "OrganizationMember": "@/lib/platform/identity/queries",
        "MembershipView": "@/lib/platform/identity/queries",
        "addMembership": "@/lib/platform/identity/queries",
        "removeMembership": "@/lib/platform/identity/queries",
        "updateMembershipRole": "@/lib/platform/identity/queries",
        "getMembership": "@/lib/platform/identity/queries",
