        "Project": "@/lib/platform/projects/schema",
        "NewProject": "@/lib/platform/projects/schema",
        "ApiKey": "@/lib/platform/projects/schema",
        "NewApiKey": "@/lib/platform/projects/schema",
        "jobs": "@/lib/jobs/schema",
        "Job": "@/lib/jobs/schema",
        "NewJob": "@/lib/jobs/schema",
        "events": "@/lib/ingest/otlp/schema",
        "eventMetrics": "@/lib/ingest/otlp/schema",
        "otelSpans": "@/lib/ingest/otlp/schema",
        "otelLogs": "@/lib/ingest/otlp/schema",
        "Event": "@/lib/ingest/otlp/schema",
        "NewEvent": "@/lib/ingest/otlp/schema",
        "EventMetricRow": "@/lib/ingest/otlp/schema",
        "NewEventMetric": "@/lib/ingest/otlp/schema",
