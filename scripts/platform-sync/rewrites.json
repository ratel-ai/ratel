        "getJobForProject": "@/lib/jobs/queries"
      }
    }
  },
  "identifiers": {
    "posthogDistinctId": "distinctId",
    "shutdownPostHog": "shutdownAnalytics",
    "clerkId": "externalId",
    "clerk_id": "external_id",
    "upsertUserByClerkId": "upsertUserByExternalId",
    "getUserByClerkId": "getUserByExternalId"
  }
}
