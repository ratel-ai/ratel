        "traceEventRejects": "@/lib/ingest/trace-events/schema",
        "toolUsageCounters": "@/lib/ingest/trace-events/schema",
        "TraceEvent": "@/lib/ingest/trace-events/schema",
        "NewTraceEvent": "@/lib/ingest/trace-events/schema",
        "TraceEventHit": "@/lib/ingest/trace-events/schema",
        "NewTraceEventHit": "@/lib/ingest/trace-events/schema",
        "TraceEventReject": "@/lib/ingest/trace-events/schema",
        "NewTraceEventReject": "@/lib/ingest/trace-events/schema",
