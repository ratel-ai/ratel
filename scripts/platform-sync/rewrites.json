        "deleteOrganization": "@/lib/platform/identity/queries",
        "SettingsDb": "@/lib/platform/identity/queries",
        "getProjectById": "@/lib/platform/projects/queries",
        "ProjectLookupDb": "@/lib/platform/projects/queries",
        "createProject": "@/lib/platform/projects/queries",
        "ProjectWriteDb": "@/lib/platform/projects/queries",
        "updateProjectName": "@/lib/platform/projects/queries",
        "getProjectBySlug": "@/lib/platform/projects/queries",
        "deleteProject": "@/lib/platform/projects/queries",
        "listProjectsForOrganization": "@/lib/platform/projects/queries",
        "ApiKeyDb": "@/lib/platform/projects/queries",
        "createApiKey": "@/lib/platform/projects/queries",
        "listApiKeysForProject": "@/lib/platform/projects/queries",
