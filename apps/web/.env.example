# Copy to .env.local

# Postgres database URL and settings.
# Default is a local Docker Compose setup.
DATABASE_URL=postgres://ratel:ratel@localhost:5432/ratel
DATABASE_MIGRATE_ON_BOOT=1

# Where SDK snippets in the console point: this deployment's origin.
# The console adds /api/v1 when it builds API and ingest URLs.
BASE_URL=http://localhost:3000

# Experimental features, all off by default: the eval gate (test a fix on the project's past
# runs before it ships), session replay with the session chat, the Traces Sessions tab, the
# Health score and the early readings, the redesigned trace views, raw OTLP capture (each
# accepted request body kept, gzipped, up to OTLP_RAW_DAILY_BYTES per project per day) and
# adaptive labelling. 1 turns them all on.
# RATEL_EXPERIMENTAL_FEATURES=1
# The eval gate's models: re-rank fixes simulate in process. Fixes that need a model replay,
# and judged criteria, call Anthropic with ANTHROPIC_API_KEY; without it they say no model is
# configured and nothing calls out. EVAL_GATE_MOCK_MODEL=1 uses deterministic stand-ins instead
# (ignored when APP_ENV is production).
# EVAL_GATE_MOCK_MODEL=1
# EVAL_GATE_REPLAY_BUDGET_USD=1
# EVAL_GATE_JUDGE_BUDGET_USD=0.1
# Advanced: one feature at a time, with FF_EVAL_GATE (run_eval and get_eval need it too),
# FF_SESSION_REPLAY (a session as a chat, and What-if), FF_TRACES_SESSIONS (Traces leads with
# Sessions and each tab's own summary), FF_HEALTH_SCORE (the Health score
# leads Agent health), FF_QUICK_FIRST_READING (a new project's first reading reads a week first) and
# FF_HEALTH_IMPORT_FIRST_READING (no verdict before a reading has scanned the imported runs) and
# FF_OTLP_RAW_CAPTURE (keep each accepted OTLP request body, gzipped).
# Raw OTLP request bodies: stored gzipped bytes one project may add per UTC day (default 1 GiB,
# 0 stores none), and their retention, which applies even with DATA_RETENTION_ENABLED unset
# (500 rows per tick).
# OTLP_RAW_DAILY_BYTES=1073741824
# OTLP_RAW_RETENTION_DAYS=30

# Where Claude calls go. Unset, ANTHROPIC_API_KEY selects the Anthropic API.
# bedrock = every Claude call goes to Amazon Bedrock through eu.* inference
# profiles, signed by the AWS credential chain; ANTHROPIC_API_KEY is never used.
# AWS_BEARER_TOKEN_BEDROCK turns Claude off (it would replace the AWS credential
# chain); ANTHROPIC_BEDROCK_BASE_URL is ignored. Any other value turns Claude off.
# ANTHROPIC_BACKEND=bedrock

# Self-telemetry: the platform's own traces and logs, over OTLP/HTTP. Off unless both
# endpoints are set; with either one unset nothing is exported and nothing leaves the
# process. The _HEADERS variables carry the collector's credentials ("key=value,key=value").
# OTEL_TRACES_SAMPLER_ARG is the share of traces kept (0 to 1, default 1) and
# OTEL_SDK_DISABLED=true turns it all off. Buffered telemetry is flushed on SIGTERM; outside
# the worker that needs NEXT_MANUAL_SIG_HANDLE=true, or Next may exit before the flush ends.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_TRACES_SAMPLER_ARG=1
