# Copy to .env.local

# Postgres database URL and settings.
# Default is a local Docker Compose setup.
DATABASE_URL=postgres://ratel:ratel@localhost:5432/ratel
DATABASE_MIGRATE_ON_BOOT=1

# Where SDK snippets in the console point: this deployment's API, with its /api/v1 prefix.
# Change this to your deployment's API URL.
BASE_URL=http://localhost:3000/api/v1
