# Copy to .env.local

# Postgres database URL and settings.
# Default is a local Docker Compose setup.
DATABASE_URL=postgres://ratel:ratel@localhost:5432/ratel
DATABASE_MIGRATE_ON_BOOT=1

# Where SDK snippets in the console point: this deployment's origin.
# The console adds /api/v1 when it builds API and ingest URLs.
BASE_URL=http://localhost:3000

# Session replay: a session step by step, from a turn page. Off by default.
# FF_SESSION_REPLAY=1

# The stage spine: the rail grouped into Monitor, Insights, Improve and Ship, the Ship page
# and the links from a fix, an issue or an experiment back to where it came from. Off by default.
# FF_STAGE_SPINE=1

# The eval gate: test a fix on the project's past runs before it ships. Off by default.
# Re-rank fixes simulate in process. Fixes that need a model replay, and judged criteria,
# call Anthropic with ANTHROPIC_API_KEY; without it they say no model is configured and
# nothing calls out. EVAL_GATE_MOCK_MODEL=1 uses deterministic stand-ins instead (ignored
# when APP_ENV is production).
# FF_EVAL_GATE=1
# EVAL_GATE_MOCK_MODEL=1
# EVAL_GATE_REPLAY_BUDGET_USD=1
# EVAL_GATE_JUDGE_BUDGET_USD=0.1

# The improvement-loop MCP tools: list_insights, list_fixes, get_fix, get_eval, run_eval,
# create_experiment and mark_fix_shipped. Off by default. run_eval and get_eval also need
# FF_EVAL_GATE.
# FF_MCP_LOOP=1
