# Copy to .env.local

# Postgres database URL and settings.
# Default is a local Docker Compose setup.
DATABASE_URL=postgres://ratel:ratel@localhost:5432/ratel
DATABASE_MIGRATE_ON_BOOT=1

# Where SDK snippets in the console point: this deployment's origin.
# The console adds /api/v1 when it builds API and ingest URLs.
BASE_URL=http://localhost:3000

# Experimental features, all off by default: the Tasks and Ship pages with the rail grouped
# into Monitor, Insights, Improve and Ship, the eval gate (test a fix on the project's past
# runs before it ships), session replay, and the improvement-loop MCP tools.
# 1 turns them all on.
# RATEL_EXPERIMENTAL_FEATURES=1
# The eval gate's models: re-rank fixes simulate in process. Fixes that need a model replay,
# and judged criteria, call Anthropic with ANTHROPIC_API_KEY; without it they say no model is
# configured and nothing calls out. EVAL_GATE_MOCK_MODEL=1 uses deterministic stand-ins instead
# (ignored when APP_ENV is production).
# EVAL_GATE_MOCK_MODEL=1
# EVAL_GATE_REPLAY_BUDGET_USD=1
# EVAL_GATE_JUDGE_BUDGET_USD=0.1
# Advanced: one feature at a time, with FF_STAGE_SPINE, FF_EVAL_GATE, FF_SESSION_REPLAY and
# FF_MCP_LOOP (run_eval and get_eval also need FF_EVAL_GATE).

# Self-telemetry: the platform's own traces and logs, over OTLP/HTTP. Off unless both
# endpoints are set; with either one unset nothing is exported and nothing leaves the
# process. The _HEADERS variables carry the collector's credentials ("key=value,key=value").
# OTEL_TRACES_SAMPLER_ARG is the share of traces kept (0 to 1, default 1) and
# OTEL_SDK_DISABLED=true turns it all off. Buffered telemetry is flushed on SIGTERM; outside
# the worker that needs NEXT_MANUAL_SIG_HANDLE=true, or Next may exit before the flush ends.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_TRACES_SAMPLER_ARG=1
