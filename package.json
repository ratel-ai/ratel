{
  "name": "ratel-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "ee:link": "node scripts/link-ee.mjs",
    "ee:unlink": "node scripts/link-ee.mjs --unlink",
    "test": "pnpm -r test",
    "check:boundary": "node scripts/check-ee-boundary.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:private": "node scripts/platform-sync/private-strings.mjs apps/web",
    "platform:sync": "node scripts/platform-sync/sync.mjs --source ../ratel-cloud"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13"
  }
}
