{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "files": {
    "includes": [
      "src/sdk/**/*.ts",
      "src/sdk/**/*.tsx",
      "src/sdk/**/*.js",
      "src/adapters/**/*.ts",
      "src/adapters/**/*.tsx",
      "src/adapters/**/*.js",
      "src/telemetry/**/*.ts",
      "src/telemetry/**/*.tsx",
      "src/telemetry/**/*.js",
      "src/rankers/**/*.ts",
      "src/rankers/**/*.tsx",
      "src/rankers/**/*.js",
      "benchmark/agent/src/**/*.ts",
      "benchmark/agent/src/**/*.tsx",
      "ee/**/*.ts",
      "ee/**/*.tsx",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "apps/**/*.mjs",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "!**/.next"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/lib/**",
        "apps/web/app/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!apps/web/lib/platform/environment.ts",
        "!apps/web/app/error.tsx",
        "!apps/web/app/global-error.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/components/console/traces/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "noAutofocus": "off",
            "noSvgWithoutTitle": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/lib/console/catalog/item-id.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/components/console/errors/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noCommentText": "off"
          }
        }
      }
    },
