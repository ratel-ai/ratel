{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "files": {
    "includes": [
      "src/sdk/**/*.ts",
      "src/sdk/**/*.tsx",
      "src/sdk/**/*.js",
      "src/adapters/**/*.ts",
      "src/adapters/**/*.tsx",
      "src/adapters/**/*.js",
      "src/telemetry/**/*.ts",
      "src/telemetry/**/*.tsx",
      "src/telemetry/**/*.js",
      "src/rankers/**/*.ts",
      "src/rankers/**/*.tsx",
      "src/rankers/**/*.js",
      "benchmark/agent/src/**/*.ts",
      "benchmark/agent/src/**/*.tsx",
      "ee/**/*.ts",
      "ee/**/*.tsx",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "apps/**/*.mjs",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "!**/.next"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/lib/**",
        "apps/web/app/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!apps/web/lib/platform/environment.ts",
        "!apps/web/app/error.tsx",
        "!apps/web/app/global-error.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
